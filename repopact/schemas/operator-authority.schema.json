{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operator-authority.schema.json",
  "title": "RepoPact public operator authority",
  "description": "Recoverable non-secret operator verification and policy declaration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority_version", "operators", "approval_classes", "profiles", "delegation", "rotation", "recovery"],
  "properties": {
    "authority_version": {"type": "string", "minLength": 1},
    "operators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operator_id", "key_id", "algorithm", "public_key", "roles"],
        "properties": {
          "operator_id": {"type": "string", "minLength": 1},
          "key_id": {"type": "string", "minLength": 1},
          "algorithm": {"const": "ed25519"},
          "public_key": {"type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
          "roles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "approval_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approval_classes", "max_delegation_depth"],
        "properties": {
          "approval_classes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "max_delegation_depth": {"type": "integer", "minimum": 0, "maximum": 32}
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "max_depth", "operator_approval_required"],
      "properties": {
        "allowed": {"type": "boolean"},
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 32},
        "operator_approval_required": {"type": "boolean"}
      }
    },
    "quorum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold"],
      "properties": {"threshold": {"type": "integer", "minimum": 1}}
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_existing_trust", "overlap_seconds"],
      "properties": {
        "requires_existing_trust": {"const": true},
        "overlap_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_existing_trust", "separate_approval_class"],
      "properties": {
        "requires_existing_trust": {"const": true},
        "separate_approval_class": {"type": "string", "minLength": 1}
      }
    }
  }
}
