{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-item.schema.json",
  "type": "object",
  "required": ["id", "title", "status", "owner_scope", "affected_scopes", "depends_on", "acceptance_criteria", "created", "updated"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "active", "blocked", "deferred", "completed"]},
    "owner_scope": {"type": "string", "minLength": 1},
    "affected_scopes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{3,}$"}, "uniqueItems": true},
    "provenance": {"enum": ["concrete", "provisional", "inferred"], "description": "Record provenance (decision 0021). Absent = concrete. provisional/inferred records are reconstructed (e.g. by adopt) and not yet proven; they may not be 'completed' until ratcheted to concrete."},
    "preflight": {
      "type": "object",
      "required": ["created_before_work_started", "created_at", "note"],
      "properties": {
        "created_before_work_started": {"const": true},
        "created_at": {"type": "string", "format": "date-time"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "state", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "state": {"enum": ["pending", "satisfied", "waived"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "provenance": {"enum": ["concrete", "provisional", "inferred"]}
        }
      }
    },
    "documentation_impact": {
      "type": "object",
      "description": "Decision 0065 (WI047): resolves whether this work item's governed code change affects durable documentation. 'affected' surfaces must name concrete documentation surfaces and link evidence that they were created, updated, or regenerated; 'none' requires a reviewable rationale. Enforcement of *presence* is conditional (governance/owners.json documentation_impact.enabled), but the shape below is always validated when present.",
      "required": ["state"],
      "properties": {
        "state": {"enum": ["affected", "none"]},
        "surfaces": {
          "type": "array",
          "items": {
            "enum": [
              "user_behavior", "api_cli", "configuration", "architecture",
              "operations", "contributor_workflow", "maturity_status",
              "examples", "generated"
            ]
          },
          "uniqueItems": true
        },
        "evidence": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "affected"}}},
          "then": {
            "required": ["surfaces", "evidence"],
            "properties": {
              "surfaces": {"minItems": 1},
              "evidence": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"state": {"const": "none"}}},
          "then": {"required": ["rationale"]}
        }
      ]
    },
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"}
  }
}
